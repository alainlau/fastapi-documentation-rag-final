# Choose: gemini, openai, or ollama
LLM_PROVIDER=gemini

# Only set keys for providers you use
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set these to models available in your account/environment
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Optional; defaults to the judge_model in config.py
JUDGE_MODEL=gemini-3.6-flash
